<%
  // Pure SVG screenshot section - simplified version
  let localY = 0
%>

<% if (plugins.screenshot) { %>
  <% if (plugins.screenshot.error) { %>
    <g class="error" transform="translate(0, <%= localY %>)">
      <text x="0" y="14" font-size="12" fill="#cb2431">
        ❌ <%= plugins.screenshot.error.message %>
      </text>
    </g>
  <% } else { %>
    <g class="screenshot-header" transform="translate(0, <%= localY %>)">
      <text x="0" y="18" font-size="14" font-weight="600" fill="#24292e">
        📸 Website screenshot
      </text>
    </g>
    <% localY += 30 %>
    <g transform="translate(<%= padding %>, <%= localY %>)">
      <text x="0" y="14" font-size="10" fill="#959da5" opacity="0.7">
        Note: Screenshot embedding not supported in Pure SVG template
      </text>
    </g>
  <% } %>
<% } %>
