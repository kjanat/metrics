<%
  // Pure SVG activity section - simplified version
  let localY = 0
%>

<% if (plugins.activity) { %>
  <% if (plugins.activity.error) { %>
    <g class="error" transform="translate(0, <%= localY %>)">
      <text x="0" y="14" font-size="12" fill="#cb2431">
        ❌ <%= plugins.activity.error.message %>
      </text>
    </g>
  <% } else { %>
    <g class="activity-header" transform="translate(0, <%= localY %>)">
      <text x="0" y="18" font-size="14" font-weight="600" fill="#24292e">
        📰 Recent activity
      </text>
    </g>
    <% localY += 30 %>
    <g transform="translate(<%= padding %>, <%= localY %>)">
      <text x="0" y="14" font-size="10" fill="#959da5" opacity="0.7">
        Note: Activity timeline available in standard template
      </text>
    </g>
  <% } %>
<% } %>
