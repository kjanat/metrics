<%
  // Pure SVG projects section - simplified version
  let localY = 0
%>

<% if (plugins.projects) { %>
  <% if (plugins.projects.error) { %>
    <!-- Error message -->
    <g class="error" transform="translate(0, <%= localY %>)">
      <text x="0" y="14" font-size="12" fill="#cb2431">
        ❌ <%= plugins.projects.error.message %>
      </text>
    </g>
  <% } else { %>
    <!-- Projects Section Header -->
    <g class="projects-header" transform="translate(0, <%= localY %>)">
      <text x="0" y="18" font-size="14" font-weight="600" fill="#24292e">
        🗂️ GitHub projects
      </text>
    </g>
    <% localY += 35 %>

    <!-- Project list -->
    <% if (plugins.projects.list?.length) { %>
      <% for (let i = 0; i < Math.min(plugins.projects.list.length, 3); i++) { %>
        <% const project = plugins.projects.list[i] %>
        <g class="project-item" transform="translate(<%= padding %>, <%= localY %>)">
          <text x="0" y="14" font-size="12" fill="#0366d6" font-weight="500">
            📋 <%= project.name %>
          </text>
          <% if (project.progress !== undefined) { %>
            <text x="0" y="30" font-size="11" fill="#586069">
              Progress: <%= Math.round(project.progress * 100) %>%
            </text>
          <% } %>
        </g>
        <% localY += 45 %>
      <% } %>
      <% if (plugins.projects.list.length > 3) { %>
        <g transform="translate(<%= padding %>, <%= localY %>)">
          <text x="0" y="14" font-size="10" fill="#959da5">
            ... and <%= plugins.projects.list.length - 3 %> more project<%= s(plugins.projects.list.length - 3) %>
          </text>
        </g>
      <% } %>
    <% } %>
  <% } %>
<% } %>
