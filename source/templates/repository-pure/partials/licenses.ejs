<%
  // Pure SVG licenses section - simplified version
  let localY = 0
%>

<% if (plugins.licenses) { %>
  <% if (plugins.licenses.error) { %>
    <g class="error" transform="translate(0, <%= localY %>)">
      <text x="0" y="14" font-size="12" fill="#cb2431">
        ❌ <%= plugins.licenses.error.message %>
      </text>
    </g>
  <% } else { %>
    <g class="licenses-header" transform="translate(0, <%= localY %>)">
      <text x="0" y="18" font-size="14" font-weight="600" fill="#24292e">
        📜 Repository licenses
      </text>
    </g>
    <% localY += 35 %>
    <% if (plugins.licenses.list?.length) { %>
      <% for (let i = 0; i < Math.min(plugins.licenses.list.length, 5); i++) { %>
        <% const license = plugins.licenses.list[i] %>
        <g class="license-item" transform="translate(<%= padding %>, <%= localY %>)">
          <text x="0" y="14" font-size="12" fill="#586069">
            📄 <%= license.name %> <% if (license.permissions) { %>(%= license.permissions.join(', ') %)<% } %>
          </text>
        </g>
        <% localY += 22 %>
      <% } %>
    <% } %>
  <% } %>
<% } %>
