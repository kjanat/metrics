<%
  // Achievements section - Milestones, badges, and accomplishments
  if (!plugins.achievements) return

  const achievements = plugins.achievements
  let localY = 0

  // Get unlocked achievements
  const unlocked = achievements.list.filter(a => a.unlocked)
  const maxDisplay = 8

  const badgeSize = 60
  const badgeSpacing = 15
  const badgesPerRow = 4
  const rows = Math.ceil(Math.min(unlocked.length, maxDisplay) / badgesPerRow)
  const sectionHeight = 100 + rows * (badgeSize + badgeSpacing + 25)
%>

<% if (unlocked.length > 0) { %>
  <!-- Achievements Section Card -->
  <rect x="0" y="0" width="<%= width %>" height="<%= sectionHeight %>" fill="#ffffff" rx="12" class="card-elevated"/>

  <!-- Section Header -->
  <g class="section-header" transform="translate(<%= padding %>, <%= padding %>)">
    <text x="0" y="22" class="section-heading">
      🏆 Achievements
    </text>
    <text x="0" y="42" class="section-subheading">
      Unlocked <%= unlocked.length %> of <%= achievements.list.length %> achievements
    </text>

    <!-- Progress Bar -->
    <%
      const progressBarWidth = 200
      const progressPercent = (unlocked.length / achievements.list.length)
    %>
    <g class="progress-bar" transform="translate(<%= width - padding - progressBarWidth %>, 28)">
      <!-- Background -->
      <rect
        x="0"
        y="0"
        width="<%= progressBarWidth %>"
        height="8"
        fill="#f3f4f6"
        rx="4"
      />
      <!-- Progress -->
      <rect
        x="0"
        y="0"
        width="<%= progressBarWidth * progressPercent %>"
        height="8"
        fill="#fbbf24"
        rx="4"
      />
      <!-- Percentage -->
      <text x="<%= progressBarWidth + 10 %>" y="7" font-size="11" font-weight="600" fill="#92400e">
        <%= Math.round(progressPercent * 100) %>%
      </text>
    </g>
  </g>

  <% localY = padding + 60 %>

  <!-- Achievement Badges Grid -->
  <g class="achievements-grid" transform="translate(<%= padding %>, <%= localY %>)">
    <% for (const [i, achievement] of unlocked.slice(0, maxDisplay).entries()) { %>
      <%
        const row = Math.floor(i / badgesPerRow)
        const col = i % badgesPerRow
        const badgeWidth = (width - 2 * padding - (badgesPerRow - 1) * badgeSpacing) / badgesPerRow
        const xPos = col * (badgeWidth + badgeSpacing)
        const yPos = row * (badgeSize + 25 + badgeSpacing)
      %>

      <g class="achievement-item animated" transform="translate(<%= xPos %>, <%= yPos %>)" style="animation-delay: <%= i * 0.05 %>s">
        <!-- Badge Background Circle -->
        <circle
          cx="<%= badgeWidth / 2 %>"
          cy="<%= badgeSize / 2 %>"
          r="<%= badgeSize / 2 %>"
          fill="#fffbeb"
          stroke="#fbbf24"
          stroke-width="2"
        />

        <!-- Inner glow circle -->
        <circle
          cx="<%= badgeWidth / 2 %>"
          cy="<%= badgeSize / 2 %>"
          r="<%= badgeSize / 2 - 5 %>"
          fill="#fef3c7"
          opacity="0.5"
        />

        <!-- Achievement Icon/Emoji -->
        <text
          x="<%= badgeWidth / 2 %>"
          y="<%= badgeSize / 2 + 10 %>"
          text-anchor="middle"
          font-size="28"
        >
          <%= achievement.icon || '🏆' %>
        </text>

        <!-- Achievement Title -->
        <text
          x="<%= badgeWidth / 2 %>"
          y="<%= badgeSize + 15 %>"
          text-anchor="middle"
          font-size="11"
          font-weight="600"
          fill="#92400e"
        >
          <%= achievement.title.length > 12 ? achievement.title.substring(0, 12) + '...' : achievement.title %>
        </text>

        <!-- Achievement Level/Tier -->
        <% if (achievement.rank) { %>
          <text
            x="<%= badgeWidth / 2 %>"
            y="<%= badgeSize + 28 %>"
            text-anchor="middle"
            font-size="9"
            fill="#b45309"
            font-weight="500"
          >
            <%= achievement.rank %>
          </text>
        <% } %>
      </g>
    <% } %>
  </g>

  <!-- Show more indicator if there are more achievements -->
  <% if (unlocked.length > maxDisplay) { %>
    <g class="more-achievements" transform="translate(<%= width / 2 %>, <%= localY + rows * (badgeSize + 25 + badgeSpacing) + 10 %>)">
      <text x="0" y="0" text-anchor="middle" font-size="11" fill="#9ca3af">
        + <%= unlocked.length - maxDisplay %> more achievements
      </text>
    </g>
  <% } %>

<% } else { %>
  <!-- No achievements unlocked -->
  <rect x="0" y="0" width="<%= width %>" height="80" fill="#ffffff" rx="12" class="card"/>
  <g class="section-header" transform="translate(<%= padding %>, <%= padding %>)">
    <text x="0" y="22" class="section-heading">
      🏆 Achievements
    </text>
    <text x="<%= width / 2 %>" y="55" text-anchor="middle" font-size="12" fill="#9ca3af">
      No achievements unlocked yet
    </text>
  </g>
<% } %>
