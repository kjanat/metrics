<%
  // Pure SVG notable contributions - Simplified version for Classic Pure
  if (!plugins.notable) return
  let localY = 0
  const itemHeight = 35
  const maxContributions = 8
%>

<% if (plugins.notable) { %>
  <% const contributions = plugins.notable.contributions.slice(0, maxContributions) %>
  <% const sectionHeight = 60 + (contributions.length ? contributions.length * itemHeight : 40) %>

  <!-- Notable Contributions Section -->
  <rect x="0" y="0" width="<%= width %>" height="<%= sectionHeight %>" fill="#f6f8fa" rx="6"/>
  <rect x="0" y="0" width="<%= width %>" height="<%= sectionHeight %>" fill="none" stroke="#d1d5da" stroke-width="1" rx="6"/>

  <!-- Section Title -->
  <text x="<%= padding + 5 %>" y="<%= padding + 18 %>" font-size="16" font-weight="600" fill="#0366d6" class="h2">
    ✨ Notable Contributions
  </text>

  <% localY = padding + 35 %>

  <% if (plugins.notable.error) { %>
    <!-- Error State -->
    <g transform="translate(<%= padding %>, <%= localY %>)">
      <text x="0" y="20" font-size="12" fill="#cb2431">
        ❌ <%= plugins.notable.error.message %>
      </text>
    </g>
  <% } else if (!contributions.length) { %>
    <!-- No Contributions -->
    <g transform="translate(<%= padding %>, <%= localY %>)">
      <text x="0" y="20" font-size="12" fill="#586069">
        No notable contributions matching filters found
      </text>
    </g>
  <% } else { %>
    <!-- Contributions List -->
    <g class="contributions-list" transform="translate(<%= padding %>, <%= localY %>)">
      <% for (const [i, {name, avatar, organization, user:{commits = 0, stars = 0, issues = 0, pulls = 0, maintainer = false, percentage = 0} = {}}] of Object.entries(contributions)) { %>
        <g class="contribution-item" transform="translate(0, <%= i * itemHeight %>)">
          <!-- Repository Name -->
          <text x="0" y="14" font-size="12" font-weight="500" fill="#0366d6">
            <%= organization ? '🏢' : '👤' %> <%= name %>
          </text>

          <!-- Stats -->
          <g transform="translate(<%= width - 2 * padding - 200 %>, 0)">
            <% let xPos = 0 %>
            <% if (commits) { %>
              <text x="<%= xPos %>" y="14" font-size="11" fill="#586069">
                ⚫ <%= commits %>
              </text>
              <% xPos += 50 %>
            <% } %>
            <% if (stars) { %>
              <text x="<%= xPos %>" y="14" font-size="11" fill="#586069">
                ⭐ <%= f(stars) %>
              </text>
              <% xPos += 50 %>
            <% } %>
            <% if (issues) { %>
              <text x="<%= xPos %>" y="14" font-size="11" fill="#586069">
                ⚪ <%= issues %>
              </text>
              <% xPos += 50 %>
            <% } %>
            <% if (pulls) { %>
              <text x="<%= xPos %>" y="14" font-size="11" fill="#586069">
                🔀 <%= pulls %>
              </text>
            <% } %>
          </g>

          <!-- Maintainer Badge -->
          <% if (maintainer) { %>
            <rect x="<%= width - 2 * padding - 80 %>" y="0" width="70" height="18" fill="#28a745" opacity="0.1" rx="3"/>
            <text x="<%= width - 2 * padding - 45 %>" y="14" text-anchor="middle" font-size="10" fill="#28a745" font-weight="600">
              MAINTAINER
            </text>
          <% } else if (percentage > 0.2) { %>
            <text x="<%= width - 2 * padding - 50 %>" y="14" text-anchor="end" font-size="10" fill="#0366d6" font-weight="600">
              <%= (percentage * 100).toFixed(0) %>%
            </text>
          <% } %>

          <!-- Separator -->
          <% if (i < contributions.length - 1) { %>
            <line x1="0" y1="<%= itemHeight - 5 %>" x2="<%= width - 2 * padding %>" y2="<%= itemHeight - 5 %>"
                  stroke="#e1e4e8" stroke-width="1"/>
          <% } %>
        </g>
      <% } %>
    </g>
  <% } %>

<% } %>
