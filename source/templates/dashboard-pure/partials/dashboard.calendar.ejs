<%
  // Dashboard contribution calendar - Pure SVG
  if (!computed.calendar || !computed.calendar.length) return
  let localY = 0
  const cellSize = 8
  const cellGap = 3
  const weeksToShow = Math.min(20, Math.ceil(computed.calendar.length / 7))
  const calendarWidth = weeksToShow * (cellSize + cellGap)
  const calendarHeight = 7 * (cellSize + cellGap)
  const panelHeight = 170
%>

<!-- Calendar Panel -->
<rect x="0" y="0" width="<%= width %>" height="<%= panelHeight %>" fill="#f6f8fa" rx="8"/>
<rect x="0" y="0" width="<%= width %>" height="<%= panelHeight %>" fill="none" stroke="#d1d5da" stroke-width="1" rx="8"/>

<!-- Section Title -->
<text x="<%= padding %>" y="<%= padding + 14 %>" font-size="14" font-weight="600" fill="#24292e">
  📅 Contribution Calendar
</text>

<% localY = padding + 35 %>

<!-- Day Labels -->
<g class="day-labels" transform="translate(<%= padding - 25 %>, <%= localY + 5 %>)">
  <text x="0" y="<%= cellSize + 3 %>" font-size="9" fill="#586069">Mon</text>
  <text x="0" y="<%= (cellSize + cellGap) * 2 + 3 %>" font-size="9" fill="#586069">Wed</text>
  <text x="0" y="<%= (cellSize + cellGap) * 4 + 3 %>" font-size="9" fill="#586069">Fri</text>
</g>

<!-- Calendar Grid -->
<g class="calendar-grid" transform="translate(<%= padding + 5 %>, <%= localY %>)">
  <%
    // Organize calendar data into weeks
    const weeks = []
    let currentWeek = []
    const startIdx = Math.max(0, computed.calendar.length - (weeksToShow * 7))

    for (let i = startIdx; i < computed.calendar.length; i++) {
      currentWeek.push(computed.calendar[i])
      if (currentWeek.length === 7) {
        weeks.push(currentWeek)
        currentWeek = []
      }
    }
    if (currentWeek.length > 0) {
      weeks.push(currentWeek)
    }
  %>

  <% for (let w = 0; w < weeks.length; w++) { %>
    <% const week = weeks[w] %>
    <% for (let d = 0; d < week.length; d++) { %>
      <% const day = week[d] %>
      <rect
        x="<%= w * (cellSize + cellGap) %>"
        y="<%= d * (cellSize + cellGap) %>"
        width="<%= cellSize %>"
        height="<%= cellSize %>"
        fill="<%= day.color %>"
        rx="2"
      >
        <title><%= day.contributions || 0 %> contributions on <%= day.date || 'unknown' %></title>
      </rect>
    <% } %>
  <% } %>
</g>

<!-- Legend -->
<g class="calendar-legend" transform="translate(<%= padding %>, <%= localY + calendarHeight + 20 %>)">
  <text x="0" y="10" font-size="10" fill="#586069">Less</text>

  <% const legendColors = ['#ebedf0', '#9be9a8', '#40c463', '#30a14e', '#216e39'] %>
  <% for (let i = 0; i < legendColors.length; i++) { %>
    <rect
      x="<%= 35 + i * (cellSize + cellGap) %>"
      y="2"
      width="<%= cellSize %>"
      height="<%= cellSize %>"
      fill="<%= legendColors[i] %>"
      rx="2"
    />
  <% } %>

  <text x="<%= 35 + legendColors.length * (cellSize + cellGap) + 5 %>" y="10" font-size="10" fill="#586069">More</text>
</g>

<!-- Summary Stats -->
<g class="calendar-summary" transform="translate(<%= padding %>, <%= localY + calendarHeight + 50 %>)">
  <%
    const totalContributions = computed.calendar.reduce((sum, day) => sum + (day.contributions || 0), 0)
    const avgPerDay = (totalContributions / computed.calendar.length).toFixed(1)
    const maxDay = Math.max(...computed.calendar.map(d => d.contributions || 0))
  %>
  <text x="0" y="12" font-size="11" fill="#586069">
    <tspan font-weight="600" fill="#24292e"><%= totalContributions %></tspan> contributions in the last year
    <tspan dx="10">•</tspan>
    <tspan dx="10"><%= avgPerDay %></tspan> avg/day
    <tspan dx="10">•</tspan>
    <tspan dx="10"><%= maxDay %></tspan> max
  </text>
</g>
