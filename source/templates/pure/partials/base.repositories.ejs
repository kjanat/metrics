<%
  // Pure SVG repositories section
  if (!base.repositories) return
  let localY = 0
  const maxRepos = 5
  const repos = data.user.repositories.nodes.slice(0, maxRepos)
%>

<% if (repos.length) { %>
  <!-- Repositories Section -->
  <rect x="0" y="0" width="<%= width %>" height="<%= 50 + repos.length * 45 %>" fill="#f6f8fa" rx="6"/>
  <rect x="0" y="0" width="<%= width %>" height="<%= 50 + repos.length * 45 %>" fill="none" stroke="#d1d5da" stroke-width="1" rx="6"/>

  <!-- Section Title -->
  <text x="<%= padding + 5 %>" y="<%= padding + 18 %>" font-size="16" font-weight="600" fill="#24292e">
    📚 Top Repositories
  </text>

  <% localY = padding + 35 %>

  <!-- Repository List -->
  <g class="repo-list" transform="translate(<%= padding %>, <%= localY %>)">
    <% for (const [i, repo] of Object.entries(repos)) { %>
      <g class="repo-item" transform="translate(0, <%= i * 45 %>)">
        <!-- Repo name -->
        <text x="0" y="14" font-size="14" font-weight="600" fill="#0969da">
          <%= repo.name %>
        </text>

        <!-- Description -->
        <% if (repo.description) { %>
          <text x="0" y="30" font-size="11" fill="#586069">
            <%= (repo.description || '').substring(0, 60) %><%= repo.description && repo.description.length > 60 ? '...' : '' %>
          </text>
        <% } %>

        <!-- Stats -->
        <g class="repo-stats" transform="translate(<%= width - 2 * padding - 150 %>, 0)">
          <!-- Stars -->
          <text x="0" y="14" font-size="11" fill="#586069">
            ⭐ <%= repo.stargazers.totalCount %>
          </text>

          <!-- Forks -->
          <text x="50" y="14" font-size="11" fill="#586069">
            🔀 <%= repo.forkCount %>
          </text>

          <!-- Language -->
          <% if (repo.primaryLanguage) { %>
            <circle cx="110" cy="9" r="5" fill="<%= repo.primaryLanguage.color || '#ccc' %>"/>
            <text x="120" y="14" font-size="11" fill="#586069">
              <%= repo.primaryLanguage.name %>
            </text>
          <% } %>
        </g>

        <!-- Separator -->
        <% if (i < repos.length - 1) { %>
          <line x1="0" y1="40" x2="<%= width - 2 * padding %>" y2="40" stroke="#e1e4e8" stroke-width="1"/>
        <% } %>
      </g>
    <% } %>
  </g>

<% } %>
