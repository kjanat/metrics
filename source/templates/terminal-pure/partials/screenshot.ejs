<%
  // Terminal-style screenshot display
  let localY = 0
  const promptColor = "#7EDA29"
  const pathColor = "#4878c0"
  const textColor = "#DDDDDD"
%>

<% if (plugins.screenshot) { %>
  <% if (!plugins.screenshot.error) { %>
    <!-- Command: view screenshot -->
    <g class="stdin" transform="translate(0, <%= localY %>)">
      <text x="0" y="0" font-size="14" font-family="'Courier New', 'Courier Prime', monospace">
        <tspan class="ps1-path" fill="<%= promptColor %>"><%= user.login.toLowerCase() %>@metrics</tspan><tspan fill="<%= textColor %>">:</tspan><tspan class="ps1-location" fill="<%= pathColor %>">~</tspan><tspan class="ps1-symbol" fill="<%= textColor %>"><%= computed.token.scopes.includes("repo") ? "#" : "$" %></tspan><tspan fill="<%= textColor %>"> view screenshot.png</tspan>
      </text>
    </g>
    <% localY += lineHeight %>

    <!-- Output: screenshot info -->
    <g class="stdout" transform="translate(0, <%= localY %>)">
      <text x="0" y="0" font-size="14" font-family="'Courier New', 'Courier Prime', monospace" fill="<%= textColor %>">
        <tspan>[Screenshot captured - <%= plugins.screenshot.url %>]</tspan>
      </text>
    </g>
  <% } %>
<% } %>
