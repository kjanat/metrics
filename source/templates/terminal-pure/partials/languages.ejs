<%
  // Terminal-style languages display
  let localY = 0
  const promptColor = "#7EDA29"
  const pathColor = "#4878c0"
  const textColor = "#DDDDDD"
  const boldColor = "#FFFFFF"
%>

<% if (plugins.languages) { %>
  <% if (!plugins.languages.error) { %>
    <!-- Command: cat github/languages -->
    <g class="stdin" transform="translate(0, <%= localY %>)">
      <text x="0" y="0" font-size="14" font-family="'Courier New', 'Courier Prime', monospace">
        <tspan class="ps1-path" fill="<%= promptColor %>"><%= user.login.toLowerCase() %>@metrics</tspan><tspan fill="<%= textColor %>">:</tspan><tspan class="ps1-location" fill="<%= pathColor %>">~</tspan><tspan class="ps1-symbol" fill="<%= textColor %>"><%= computed.token.scopes.includes("repo") ? "#" : "$" %></tspan><tspan fill="<%= textColor %>"> cat github/languages</tspan>
      </text>
    </g>
    <% localY += lineHeight %>

    <!-- Output: languages list -->
    <g class="stdout" transform="translate(0, <%= localY %>)">
      <%
        const languages = plugins.languages.favorites || []
        const maxBarWidth = width - 150
      %>

      <% languages.forEach((lang, idx) => { %>
        <g transform="translate(0, <%= idx * lineHeight %>)">
          <!-- Language name and percentage -->
          <text x="0" y="0" font-size="14" font-family="'Courier New', 'Courier Prime', monospace" fill="<%= textColor %>">
            <tspan font-weight="700" fill="<%= boldColor %>"><%= lang.name.padEnd(15) %></tspan>
            <tspan><%= `${lang.value.toFixed(1)}%`.padStart(7) %></tspan>
          </text>

          <!-- ASCII bar chart -->
          <% const barLength = Math.ceil((lang.value / 100) * 30) %>
          <text x="160" y="0" font-size="14" font-family="'Courier New', 'Courier Prime', monospace" fill="<%= lang.color %>">
            <tspan>[<%= '█'.repeat(barLength) %><%= '░'.repeat(30 - barLength) %>]</tspan>
          </text>
        </g>
      <% }) %>

      <% localY += languages.length * lineHeight %>
    </g>
  <% } %>
<% } %>
